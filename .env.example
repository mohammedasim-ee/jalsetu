# Copy to .env (never commit it) or set these in your hosting dashboard (Vercel: Settings -> Environment Variables).

# Database. Leave empty to use a local SQLite file. Vercel's Neon integration sets DATABASE_URL automatically.
DATABASE_URL=
JALSETU_DB=./jalsetu.db

# Admin account, created on startup. Password: 12+ characters. Required for the /admin dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: AI photo checks and lab-report reading (paid per use). Leave empty to keep AI off.
ANTHROPIC_API_KEY=
JALSETU_AI_MODEL=claude-haiku-4-5-20251001

# Optional
JALSETU_DEMO=            # 1 = add clearly labelled DEMO rows on startup
CORS_ORIGINS=            # comma-separated origins allowed to call the API from other sites (default: same origin only)
JALSETU_WRITE_LIMIT=30   # writes per IP per 10 minutes
JALSETU_LOGIN_LIMIT=10   # login/register attempts per IP per 10 minutes
